{
  "name": "atelier-desktop",
  "version": "1.0.2",
  "description": "Atelier Workstation Desktop Application",
  "main": "main.js",
  "author": "dxvzz",
  "repository": "github:dxvzz/atelier-desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:all": "electron-builder --win --linux"
  },
  "devDependencies": {
    "electron": "31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.atelierws.desktop",
    "productName": "Atelier Workstation",
    "copyright": "Copyright © 2026 Atelier WS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "linux": {
  "target": [
    "tar.gz",
    "deb"
  ],
  "category": "Utility",
  "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerSidebar": "installerSidebar.bmp",
      "installerHeader": "installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier Workstation"
    }
  }
}